; Test fixture: header, first 400 moves and footer of the calibration cube G-code,
; written by tools/toolpath_to_gcode.py from tests/golden/calibration_cube.toolpath.npz
; on the CPU backend (reference machine profile).
G21 ; set units to millimeters
G90 ; use absolute coordinates
M190 S55 ; wait for bed temperature to be reached
G32 ; homing and bed calibration
M104 S210 ; set temperature
M109 S210 ; wait for temperature to be reached
T0
M82 ; use absolute distances for extrusion
; switch to enable 3Z mode
M98 P"/macros/enable3Z.g"
M400 ; wait 
; purging line
